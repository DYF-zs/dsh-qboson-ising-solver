{
  "name": "dsh-qboson-ising-solver",
  "version": "0.2.0",
  "description": "QBoson Kaiwu combinatorial optimization modeling and SPQC hardware solving for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DYF-zs/dsh-qboson-ising-solver.git"
  },
  "homepage": "https://github.com/DYF-zs/dsh-qboson-ising-solver#readme",
  "bugs": {
    "url": "https://github.com/DYF-zs/dsh-qboson-ising-solver/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./provider-kaiwu": "./src/provider-kaiwu.js",
    "./tool": "./src/tool.js",
    "./service": "./src/service.js",
    "./skills": "./src/skills.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./runtime-manager": "./src/runtime-manager.js"
  },
  "files": [
    "assets/kaiwu-optimization",
    "src",
    "types",
    "python/qboson_ising_worker/*.py",
    "bin",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "pyproject.toml"
  ],
  "bin": {
    "dsh-ising-doctor": "./bin/dsh-ising-doctor.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:python": "python -m unittest discover -s python/tests -p \"test_*.py\"",
    "check": "npm test && npm run test:python",
    "doctor": "node ./bin/dsh-ising-doctor.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ising",
    "qboson",
    "kaiwu",
    "spqc",
    "optimization"
  ],
  "license": "UNLICENSED"
}
